# ============================================
# Base URLs
# ============================================
# URL base del frontend de Ithaka
ITHAKA_BASE_URL=

# URL base del frontend de Nettra
NETTRA_BASE_URL=

# ============================================
# Execution Configuration
# ============================================
# Ejecutar en modo headless (true / false)
HEADLESS=true

# ============================================
# Viewport Configuration
# ============================================
# Ancho del viewport en píxeles
DEFAULT_VIEWPORT_WIDTH=1280

# Alto del viewport en píxeles
DEFAULT_VIEWPORT_HEIGHT=720

# ============================================
# Timeouts (milisegundos)
# ============================================
# Timeout por defecto para acciones (click, fill, etc.)
ACTION_TIMEOUT=10000

# Timeout por defecto para navegación
NAVIGATION_TIMEOUT=30000